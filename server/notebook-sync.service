[Unit]
Description=Sakura Notes Cloud Sync (FastAPI)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/notebook-sync
Environment=PYTHONUNBUFFERED=1
Environment=SECRET_KEY=sakura-notebook-978021-change-me
ExecStart=/opt/notebook-sync/venv/bin/uvicorn main:app --host 127.0.0.1 --port 18081
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
